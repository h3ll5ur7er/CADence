{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "cadence": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "cad",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": ["opentype.js"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "planegcs.wasm",
                "input": "node_modules/@salusoft89/planegcs/dist/planegcs_dist",
                "output": "wasm"
              },
              {
                "glob": "replicad_single.wasm",
                "input": "node_modules/replicad-opencascadejs/dist",
                "output": "wasm"
              },
              {
                "glob": "inter-latin-{400,700}-normal.woff",
                "input": "node_modules/@fontsource/inter/files",
                "output": "fonts"
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/@fontsource/inter",
                "output": "fonts"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "externalDependencies": [
              "node:module"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cadence:build:production"
            },
            "development": {
              "buildTarget": "cadence:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": [
              "src/app/**/*.spec.ts"
            ],
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  }
}
