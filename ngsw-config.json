{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/icon*",
          "/fonts/*",
          "/templates/*.json",
          "/third-party-licences.txt"
        ]
      }
    },
    {
      "name": "kernels",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/wasm/*.wasm"
        ]
      }
    }
  ]
}
