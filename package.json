{
  "name": "cadence",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "node tools/pages/build.mjs",
    "build:automation": "node tools/automation/build.mjs",
    "cadence": "node dist/automation/cadence.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:core && npm run test:app",
    "test:core": "vitest run -c vitest.core.config.ts",
    "test:app": "ng test --watch=false",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.automation.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "e2e": "playwright test",
    "e2e:pages": "npm run build:pages && playwright test -c playwright.pages.config.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:automation",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.2",
    "@fontsource/inter": "^5.3.0",
    "@salusoft89/planegcs": "^1.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "buffer": "6.0.3",
    "isomorphic-git": "1.42.5",
    "opentype.js": "^2.0.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "angular-eslint": "^22.6.0",
    "dxf-parser": "^1.1.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  }
}
