{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CADence",
  "version": "0.47.1",
  "identifier": "dev.cadence.app",
  "build": {
    "frontendDist": "../dist/cadence/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CADence",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Emanuel Knecht",
    "copyright": "Emanuel Knecht",
    "category": "Graphics and Design",
    "shortDescription": "Parametric CAD for 3D printing and laser cutting",
    "longDescription": "CADence is a parametric CAD application for 3D printing and laser cutting: sketches, features, assemblies, analysis and export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "cadence"
        ],
        "name": "CADence project",
        "description": "CADence project archive",
        "role": "Editor",
        "mimeType": "application/vnd.cadence+zip"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MzdGQTFCMkU2Q0E5OEEKUldTS3FXd3VHL28zUkdLWHJqNFBZajErL2JyVTdwUEJQV0tTNjBWWVN6Nm1OTGw1N0VMb1pQbWUK",
      "endpoints": [
        "https://github.com/h3ll5ur7er/CADence/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
